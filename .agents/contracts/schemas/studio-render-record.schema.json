{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio render record",
  "type": "object",
  "required": [
    "schema_version",
    "produced_by",
    "created_at",
    "output",
    "hyperframes",
    "inputs",
    "frames"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "probe"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "probe": {
          "type": "object",
          "required": [
            "duration_s",
            "streams"
          ],
          "additionalProperties": false,
          "properties": {
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "streams": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "hyperframes": {
      "type": "object",
      "required": [
        "version",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "index_sha256",
        "config_sha256",
        "studio_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "studio_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "produced_by": {
      "enum": [
        "render",
        "manual"
      ]
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": [
        "shot_id",
        "composition",
        "asset",
        "asset_sha256",
        "take",
        "manifest",
        "manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{12,64}$"
        },
        "take": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
