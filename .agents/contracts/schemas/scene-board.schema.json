{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-board.schema.json",
  "title": "Scene board record",
  "type": "object",
  "required": [
    "schema_version",
    "scene",
    "status",
    "level",
    "level_reason",
    "render_style",
    "aspect_ratio",
    "shot_plan_sha256",
    "panels"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "scene": {"type": "string", "pattern": "^scene-[0-9]{2}$"},
    "status": {"enum": ["draft", "ready"]},
    "level": {"enum": ["L1", "L2", "L3"]},
    "level_reason": {"type": "string", "minLength": 1},
    "render_style": {"enum": ["pencil", "ink", "charcoal", "limited-palette", "full-colour"]},
    "aspect_ratio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "shot_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot", "level", "reason"],
        "additionalProperties": false,
        "properties": {
          "shot": {"$ref": "#/$defs/shotId"},
          "level": {"enum": ["L1", "L2", "L3"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "layout": {"$ref": "#/$defs/layout"},
    "panels": {"type": "array", "items": {"$ref": "#/$defs/panel"}}
  },
  "$defs": {
    "shotId": {"type": "string", "pattern": "^s[0-9]{2}_sh[0-9]{3}(_[a-z]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "layout": {
      "type": "object",
      "required": ["room"],
      "additionalProperties": false,
      "properties": {
        "room": {
          "type": "object",
          "required": ["width", "depth"],
          "additionalProperties": false,
          "properties": {
            "width": {"type": "number", "exclusiveMinimum": 0},
            "depth": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"type": "string"}
          }
        },
        "axis": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": {"$ref": "#/$defs/point"},
            "to": {"$ref": "#/$defs/point"},
            "note": {"type": "string"}
          }
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "at"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "at": {"$ref": "#/$defs/point"},
              "direction": {"type": "string"},
              "switched_on_by": {"type": "string"}
            }
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "at"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z]$"},
              "label": {"type": "string", "minLength": 1},
              "at": {"$ref": "#/$defs/point"}
            }
          }
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["file", "sha256", "operation"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "operation": {"enum": ["generate", "edit"]},
        "parent_sha256": {"$ref": "#/$defs/sha256"},
        "dimension": {"type": "string"},
        "bbox": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 999},
          "minItems": 4,
          "maxItems": 4
        },
        "prompt_file": {"type": "string"},
        "task_id": {"type": "string"},
        "rejected": {"type": "boolean"}
      }
    },
    "panel": {
      "type": "object",
      "required": ["id", "clip", "shot", "state", "duration_s", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]{2}_sh[0-9]{3}_p[0-9]{3}$"},
        "clip": {"type": "string", "pattern": "^s[0-9]{2}_sh[0-9]{3}$"},
        "shot": {"$ref": "#/$defs/shotId"},
        "state": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "shot_level": {"enum": ["L1", "L2", "L3"]},
        "shot_level_reason": {"type": "string", "minLength": 1},
        "beat": {"type": "string"},
        "framing": {
          "enum": [
            "single",
            "dirty single",
            "two-shot",
            "three-shot",
            "group",
            "over-the-shoulder",
            "over-the-hip",
            "point of view",
            "insert"
          ]
        },
        "featured": {"type": "array", "items": {"type": "string"}},
        "size": {"type": "string"},
        "angle": {"type": "string"},
        "move": {"type": "string"},
        "lens_intent": {"type": "string"},
        "light": {"type": ["object", "string"]},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "dialogue": {"type": ["string", "null"]},
        "sound_cue": {"type": ["string", "null"]},
        "transition_in": {"type": "string"},
        "screen_direction": {"type": "string"},
        "continuity_carry": {"type": "array", "items": {"type": "string"}},
        "elements": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["planned", "review", "needs_edit", "approved", "rejected"]},
        "file": {"type": ["string", "null"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}},
        "decision": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
