{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_path",
    "artifact_sha256",
    "status",
    "inspection_method",
    "coverage",
    "checks",
    "observations",
    "limitations",
    "recommendation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail", "incomplete"]},
    "inspection_method": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "incomplete", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1},
          "score": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
