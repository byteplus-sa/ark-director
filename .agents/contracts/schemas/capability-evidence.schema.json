{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "source",
    "verified_at",
    "operations",
    "parameters",
    "reference_roles",
    "max_references"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "profile_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "transport": {"enum": ["ark-mcp", "arkcli", "curl"]},
    "tool_schema_revision": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "per_modality_limits": {
      "type": "object",
      "required": ["image", "video", "audio"],
      "properties": {
        "image": {"type": ["integer", "null"], "minimum": 0},
        "video": {"type": ["integer", "null"], "minimum": 0},
        "audio": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "conditional_parameters": {
      "type": "array",
      "items": {"type": "object"}
    },
    "preview": {
      "type": "object",
      "required": ["native_draft", "promotion", "parameters"],
      "properties": {
        "native_draft": {"type": ["boolean", "null"]},
        "promotion": {"type": ["boolean", "null"]},
        "parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parameters": {
      "type": "object"
    },
    "required_parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_references": {
      "type": "integer",
      "minimum": 0
    },
    "supports_first_frame_with_reference_images": {
      "type": "boolean"
    }
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
    "then": {
      "required": [
        "profile_id", "provider", "operation", "transport", "tool_schema_revision",
        "valid_from", "valid_until", "per_modality_limits", "conditional_parameters",
        "preview"
      ],
      "properties": {"operations": {"minItems": 1, "maxItems": 1}}
    }
  }],
  "additionalProperties": true
}
